# Settings of kuterlapa-speech. Copy to ~/.config/kuterlapa/speech.toml.
# Every setting is optional; the values below are the defaults.

# Recognition backend: "mlx" (Apple Silicon Macs) or "faster-whisper"
# (Linux, Windows; NVIDIA GPU or CPU). Empty: chosen for this computer.
# Install the matching extra: kuterlapa-speech[mlx] or [faster-whisper].
backend = ""

# A model id or a local folder with a model for the backend. Empty: the
# backend's default, Whisper large-v3-turbo.
model = ""

# Language of the speech (ISO 639-1 code).
language = "pl"

# First sentence of Whisper's context: the language and style of the speech.
prompt_intro = "Rozmawiamy po polsku z angielskimi terminami IT."

# Input device name; empty means the system default.
microphone = ""

# Close the microphone after this many seconds without a recording, so
# macOS stops showing its microphone indicator. 0 keeps it open all the
# time. While it is open, the words just before a button press are kept.
microphone_idle_close = 30

# A chat message (Y) sends itself after a pause: after `auto_finish`
# seconds of silence, but never before `auto_finish_min` seconds from the
# start of the recording. After `countdown_after` seconds of silence the
# overlay shows a bar that counts down. Speaking again stops the countdown.
auto_finish = 3.0
countdown_after = 1.0
auto_finish_min = 10.0

# Word lists for Whisper's context, one word or phrase per line,
# most important first. Whisper reads only about 200 tokens of context.
dictionaries = ["~/.config/kuterlapa/dictionary.txt"]

# Fixes applied after recognition, one "wrong => right" per line.
replacements = "~/.config/kuterlapa/replacements.txt"

# Where recordings and their text are saved.
recordings = "~/.local/share/kuterlapa/recordings"
